# Beam attitude configuration
BEAM_MAX_ABS_PITCH_DEG=89
BEAM_MOUNT_ANT_TO_BODY_ROTATION=1,0,0,0,1,0,0,0,1
MOUNT_ORTHOGONAL_ABSOLUTE_TOLERANCE=0.000001
MOUNT_ORTHOGONAL_RELATIVE_TOLERANCE=0.0

# Beam search grid configuration
BEAM_SEARCH_AZIMUTH_COUNT=21
BEAM_SEARCH_ELEVATION_COUNT=9
BEAM_SEARCH_AZIMUTH_START_DEG=-42
BEAM_SEARCH_AZIMUTH_STEP_DEG=4.2
BEAM_SEARCH_ELEVATION_START_DEG=3
BEAM_SEARCH_ELEVATION_STEP_DEG=4.4
BEAM_SEARCH_WIDTH_DEG=6

# Requested beam configuration
BEAM_CONFIRMATION_WIDTH_DEG=3
BEAM_TRACKING_WIDTH_DEG=3

# Requested (confirmation/tracking) beam coverage, antenna frame. Boundaries are included.
BEAM_REQUEST_COVERAGE_AZIMUTH_MIN_DEG=-60
BEAM_REQUEST_COVERAGE_AZIMUTH_MAX_DEG=60
BEAM_REQUEST_COVERAGE_ELEVATION_MIN_DEG=-10
BEAM_REQUEST_COVERAGE_ELEVATION_MAX_DEG=60

# Target configuration
TARGET_MAX_ASSOCIATION_SPEED_MPS=1000
TARGET_MAX_INITIAL_DOPPLER_DIFFERENCE_MPS=30
TARGET_MEASUREMENT_STANDARD_DEVIATION_M=7
TARGET_POSITION_NDS_THRESHOLD=11.345
TARGET_CONFIRMATION_DELAY_MS=100
TARGET_TRACKING_INTERVAL_MS=1000
TARGET_MAX_CONSECUTIVE_TRACKING_MISSES=3
TARGET_INITIAL_ACCELERATION_STANDARD_DEVIATION_MPS2=10
TARGET_MAX_REPORTED_TRACK_COUNT=100
# Per-interval constant-acceleration disturbance standard deviation (1 sigma).
TARGET_PROCESS_ACCELERATION_STANDARD_DEVIATION_MPS2=10

# Communication configuration
COMM_SERVER_ADDRESS=192.168.10.20
COMM_SERVER_PORT=3200
COMM_OPERATOR_CONSOLE_ADDRESS=192.168.10.10
COMM_OPERATOR_CONSOLE_PORT=3100
COMM_SCENARIO_SIMULATOR_ADDRESS=192.168.10.100
COMM_SCENARIO_SIMULATOR_PORT=3300
